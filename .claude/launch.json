{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "adaptive-scheduler-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev"],
      "port": 3000
    },
    {
      "name": "solver-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && source .venv/bin/activate && uvicorn api.main:app --reload --port 8000"],
      "port": 8000,
      "url": "http://localhost:8000"
    }
  ]
}
