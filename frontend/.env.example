# Public - safe to expose client-side by Supabase's own design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (no NEXT_PUBLIC_ prefix - never sent to the browser). Used by
# app/api/update-schedule/route.ts to call the stateless FastAPI solver
# service (backend/). SOLVER_SHARED_SECRET must match the same-named
# variable in backend/.env exactly.
SOLVER_URL=http://localhost:8000
SOLVER_SHARED_SECRET=

# Server-only. Same Google OAuth client Supabase's dashboard already uses
# for Sign in with Google (Authentication > Providers > Google there) -
# copy its Client ID/Secret from Google Cloud Console here too. Needed
# because refreshing a Google access token (lib/google/credentials.ts)
# means calling Google's token endpoint directly - Supabase never does
# this refresh on your behalf, it only ever refreshes its own session JWT.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Server-only. Credentials for the dedicated E2E test user that Playwright
# signs in as via signInWithPassword (scripts/create-e2e-test-user.ts,
# e2e/auth.setup.ts) - bypasses real Google OAuth, which can't be scripted
# reliably. Only grants access to that one throwaway account's own
# RLS-scoped rows, unlike the service role key below.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# NOT a normal env var - never added to .env.local. Only ever passed inline,
# once, on the command line to run scripts/create-e2e-test-user.ts:
#   SUPABASE_SERVICE_ROLE_KEY=... NEXT_PUBLIC_SUPABASE_URL=... \
#   E2E_TEST_EMAIL=... E2E_TEST_PASSWORD=... npm run create-e2e-test-user
# Bypasses RLS entirely - the most sensitive credential this app ever
# touches. Find it in the Supabase dashboard under Project Settings > API.
# SUPABASE_SERVICE_ROLE_KEY=
