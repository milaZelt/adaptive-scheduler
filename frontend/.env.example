# Public - safe to expose client-side by Supabase's own design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (no NEXT_PUBLIC_ prefix - never sent to the browser). Used by
# app/api/update-schedule/route.ts to call the stateless FastAPI solver
# service (backend/). SOLVER_SHARED_SECRET must match the same-named
# variable in backend/.env exactly.
SOLVER_URL=http://localhost:8000
SOLVER_SHARED_SECRET=

# Server-only. Same Google OAuth client Supabase's dashboard already uses
# for Sign in with Google (Authentication > Providers > Google there) -
# copy its Client ID/Secret from Google Cloud Console here too. Needed
# because refreshing a Google access token (lib/google/credentials.ts)
# means calling Google's token endpoint directly - Supabase never does
# this refresh on your behalf, it only ever refreshes its own session JWT.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
